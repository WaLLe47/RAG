# Скопируйте этот файл в .env и при необходимости измените значения.
# Все переменные опциональны — без .env используются значения по умолчанию.

# --- Qdrant ---
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_COLLECTION=documents

# --- Ollama (LLM) ---
OLLAMA_URL=http://localhost:11434/api/generate
OLLAMA_TAGS_URL=http://localhost:11434/api/tags
OLLAMA_MODEL=qwen2.5:14b

# --- Модели ---
EMBEDDING_MODEL=BAAI/bge-m3
VECTOR_SIZE=1024
RERANKER_MODEL=BAAI/bge-reranker-base

# Устройство эмбеддингов/реранкера: cpu (экономит VRAM для LLM) или cuda.
EMBED_DEVICE=cpu
